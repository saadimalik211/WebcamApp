<Window x:Class="WebcamApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MainWindow"
        Height="850"
        Width="1100">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="200"/>
        </Grid.RowDefinitions>


        <!-- Main controls -->
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Margin="10">

            <Button x:Name="StartButton"
                    Content="Start Webcam"
                    Width="100"
                    Height="30"
                    Click="StartWebcam_Click"/>

            <Button x:Name="StopButton"
                    Content="Stop Webcam"
                    Width="100"
                    Height="30"
                    Margin="10,0,0,0"
                    Click="StopWebcam_Click"/>

        </StackPanel>


        <!-- Filter Pipeline -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="10,0,10,10">

            <!-- Available Filters -->
            <StackPanel>
                <TextBlock Text="Available Filters"
                           Margin="0,0,0,5"/>

                <ListBox x:Name="AvailableFilterList"
                         Width="180"
                         Height="100"/>
            </StackPanel>


            <!-- Add / Remove buttons -->
            <StackPanel Margin="20,20,0,0">

                <Button Content="Add →"
                        Width="80"
                        Click="AddFilter_Click"/>

                <Button Content="← Remove"
                        Width="80"
                        Margin="0,10,0,0"
                        Click="RemoveFilter_Click"/>

            </StackPanel>


            <!-- Active Pipeline -->
            <StackPanel Margin="20,0,0,0">

                <TextBlock Text="Active Pipeline"
                           Margin="0,0,0,5"/>

                <ListBox x:Name="FilterPipelineList"
                         Width="180"
                         Height="100"/>

            </StackPanel>

        </StackPanel>


        <!-- Filter settings -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Margin="10,0,10,10">

            <!-- Blur -->
            <TextBlock Text="Blur:"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>

            <Slider x:Name="BlurSlider"
                    Width="200"
                    Minimum="1"
                    Maximum="21"
                    Value="15"
                    TickFrequency="2"
                    IsSnapToTickEnabled="True"
                    ValueChanged="BlurSlider_ValueChanged"/>


            <!-- BW Threshold -->
            <TextBlock Text="BW Threshold:"
                       VerticalAlignment="Center"
                       Margin="20,0,10,0"/>

            <Slider x:Name="BWThresholdSlider"
                    Width="150"
                    Minimum="0"
                    Maximum="255"
                    Value="128"
                    TickFrequency="5"
                    IsSnapToTickEnabled="True"
                    ValueChanged="BWThresholdSlider_ValueChanged"/>


            <!-- Edge Lower -->
            <TextBlock Text="Edge Lower:"
                       VerticalAlignment="Center"
                       Margin="20,0,10,0"/>

            <Slider x:Name="EdgeLowerSlider"
                    Width="150"
                    Minimum="0"
                    Maximum="255"
                    Value="50"
                    TickFrequency="5"
                    IsSnapToTickEnabled="True"
                    ValueChanged="EdgeLowerSlider_ValueChanged"/>


            <!-- Edge Upper -->
            <TextBlock Text="Edge Upper:"
                       VerticalAlignment="Center"
                       Margin="20,0,10,0"/>

            <Slider x:Name="EdgeUpperSlider"
                    Width="150"
                    Minimum="0"
                    Maximum="255"
                    Value="150"
                    TickFrequency="5"
                    IsSnapToTickEnabled="True"
                    ValueChanged="EdgeUpperSlider_ValueChanged"/>

        </StackPanel>


        <!-- Webcam -->
        <Image x:Name="WebcamImage"
               Grid.Row="3"
               Stretch="Uniform"/>


        <!-- Histogram -->
        <Canvas x:Name="HistogramCanvas"
                Grid.Row="4"
                Background="LightGray"/>

    </Grid>

</Window>